{
  "name": {
    "en": "B-hyve Watering Zone"
  },
  "class": "sprinkler",
  "capabilities": [
    "onoff",
    "manual_watering_minutes",
    "watering_time_remaining",
    "next_start",
    "smart_watering",
    "measure_moisture",
    "meter_water"
  ],
  "capabilitiesOptions": {
    "onoff": {
      "title": {
        "en": "Watering"
      },
      "insightsTitleTrue": {
        "en": "Started watering"
      },
      "insightsTitleFalse": {
        "en": "Stopped watering"
      },
      "duration": true
    }
  },
  "platforms": ["local"],
  "connectivity": ["cloud"],
  "images": {
    "small": "{{driverAssetsPath}}/images/small.png",
    "large": "{{driverAssetsPath}}/images/large.png",
    "xlarge": "{{driverAssetsPath}}/images/xlarge.png"
  },
  "pair": [
    {
      "id": "login_credentials",
      "template": "login_credentials",
      "options": {
        "title": {
          "en": "Log in with your B-hyve account"
        },
        "usernameLabel": {
          "en": "E-mail address"
        },
        "usernamePlaceholder": {
          "en": "you@example.com"
        },
        "passwordLabel": {
          "en": "Password"
        },
        "passwordPlaceholder": {
          "en": "Password"
        }
      }
    },
    {
      "id": "list_devices",
      "template": "list_devices",
      "navigation": {
        "next": "add_devices"
      }
    },
    {
      "id": "add_devices",
      "template": "add_devices"
    }
  ],
  "repair": [
    {
      "id": "login_credentials",
      "template": "login_credentials",
      "options": {
        "title": {
          "en": "Log in again with your B-hyve account"
        }
      }
    }
  ]
}
