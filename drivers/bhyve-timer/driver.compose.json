{
  "name": {
    "en": "B-hyve Sprinkler Timer"
  },
  "class": "sprinkler",
  "capabilities": [
    "run_mode",
    "rain_delay_active",
    "rain_delay_remaining",
    "next_start",
    "measure_battery",
    "alarm_generic"
  ],
  "capabilitiesOptions": {
    "alarm_generic": {
      "title": {
        "en": "Station fault"
      }
    }
  },
  "energy": {
    "batteries": [
      "AA",
      "AA"
    ]
  },
  "platforms": [
    "local"
  ],
  "connectivity": [
    "cloud"
  ],
  "images": {
    "small": "{{driverAssetsPath}}/images/small.png",
    "large": "{{driverAssetsPath}}/images/large.png",
    "xlarge": "{{driverAssetsPath}}/images/xlarge.png"
  },
  "pair": [
    {
      "id": "login_credentials",
      "template": "login_credentials",
      "options": {
        "title": {
          "en": "Log in with your B-hyve account"
        },
        "usernameLabel": {
          "en": "E-mail address"
        },
        "usernamePlaceholder": {
          "en": "you@example.com"
        },
        "passwordLabel": {
          "en": "Password"
        },
        "passwordPlaceholder": {
          "en": "Password"
        }
      }
    },
    {
      "id": "list_devices",
      "template": "list_devices",
      "navigation": {
        "next": "add_devices"
      }
    },
    {
      "id": "add_devices",
      "template": "add_devices"
    }
  ],
  "repair": [
    {
      "id": "login_credentials",
      "template": "login_credentials",
      "options": {
        "title": {
          "en": "Log in again with your B-hyve account"
        }
      }
    }
  ]
}
