        {
          "name": "mode",
          "type": "string",
          "title": {
            "en": "Mode"
          },
          "example": "auto"
        }
      ]
    },
    {
      "id": "station_fault",
      "title": {
        "en": "Station fault detected"
      },
      "tokens": [
        {
          "name": "faults",
          "type": "string",
