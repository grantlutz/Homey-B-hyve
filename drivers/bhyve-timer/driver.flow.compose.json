        },
        {
          "name": "cause",
          "type": "string",
          "title": {
            "en": "Cause"
          },
          "example": "auto"
        },
        {
          "name": "weather",
          "type": "string",
          "title": {
            "en": "Weather type"
          },
          "example": "rain"
        }
      ]
    },
    {
      "id": "rain_delay_ended",
      "title": {
        "en": "Rain delay ended"
      }
    },
    {
      "id": "mode_changed",
      "title": {
        "en": "Mode changed"
      },
